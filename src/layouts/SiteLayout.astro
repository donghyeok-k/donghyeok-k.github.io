---
interface Props {
  title: string;
  description: string;
  lang?: string;
  bodyClass?: string;
  ogType?: "website" | "article";
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  profilePage?: boolean;
}

const {
  title,
  description,
  lang = "ko",
  bodyClass = "",
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  tags = [],
  profilePage = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteRoot = new URL(base, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const defaultImageUrl = new URL(
  `${base}images/donghyeok-kim-cutout.webp`,
  Astro.site,
);
const imageUrl = image
  ? new URL(image.replace(/^\//, ""), siteRoot)
  : defaultImageUrl;
const sitemapUrl = new URL("sitemap-index.xml", siteRoot);
const locale = lang === "ko" ? "ko_KR" : "en_US";
const personId = new URL("#donghyeok-kim", siteRoot).href;
const websiteId = new URL("#website", siteRoot).href;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteRoot.href,
      name: "Donghyeok Kim",
      alternateName: "김동혁",
      inLanguage: ["ko", "en"],
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Donghyeok Kim",
      alternateName: "김동혁",
      url: siteRoot.href,
      image: defaultImageUrl.href,
      affiliation: {
        "@type": "CollegeOrUniversity",
        name: "Korea Institute of Energy Technology (KENTECH)",
        alternateName: "한국에너지공과대학교",
        url: "https://www.kentech.ac.kr/",
      },
      knowsAbout: [
        "Energy systems",
        "Applied artificial intelligence",
        "Quantitative trading",
      ],
      description:
        "KENTECH 1기 학생이자 제2대 총학생회장을 역임한 에너지 시스템·응용 AI 연구자 지망생.",
      hasOccupation: {
        "@type": "Occupation",
        name: "Former President of the 2nd KENTECH Student Council",
        occupationLocation: {
          "@type": "CollegeOrUniversity",
          name: "Korea Institute of Energy Technology (KENTECH)",
        },
      },
      sameAs: ["https://github.com/donghyeok-k"],
    },
    ...(profilePage
      ? [
          {
            "@type": "ProfilePage",
            "@id": `${canonicalUrl.href}#profile-page`,
            url: canonicalUrl.href,
            name: title,
            description,
            inLanguage: ["ko", "en"],
            mainEntity: { "@id": personId },
            isPartOf: { "@id": websiteId },
          },
        ]
      : []),
    ...(ogType === "article" && publishedTime
      ? [
          {
            "@type": "BlogPosting",
            "@id": `${canonicalUrl.href}#article`,
            url: canonicalUrl.href,
            headline: title.replace(/ — Donghyeok Kim$/, ""),
            description,
            image: imageUrl.href,
            datePublished: publishedTime.toISOString(),
            dateModified: (modifiedTime ?? publishedTime).toISOString(),
            inLanguage: lang,
            keywords: tags,
            author: { "@id": personId },
            publisher: { "@id": personId },
            isPartOf: { "@id": websiteId },
            mainEntityOfPage: canonicalUrl.href,
          },
        ]
      : []),
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
const homeUrl = base;
const profileUrl = `${base}career/`;
const blogUrl = `${base}blog/`;
const analysisUrl = `${base}analysis/`;
const archiveUrl = `${base}archive/`;
const contactEmail = "lucaskdh@kentech.ac.kr";
const isProfile = Astro.url.pathname.startsWith(profileUrl);
const isBlog = Astro.url.pathname.startsWith(blogUrl);
const isAnalysis = Astro.url.pathname.startsWith(analysisUrl);
const isArchive = Astro.url.pathname.startsWith(archiveUrl);
const isHome = !isProfile && !isBlog && !isAnalysis && !isArchive;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Donghyeok Kim (김동혁)" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    {
      googleSiteVerification && (
        <meta name="google-site-verification" content={googleSiteVerification} />
      )
    }
    <meta name="theme-color" content="#f7f4ee" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:site_name" content="Donghyeok Kim" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Donghyeok Kim" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={structuredDataJson} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-512.png`} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Noto+Serif+KR:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body id="top" class={bodyClass}>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>

    <header class="site-header page-shell">
      <a class="wordmark" href={homeUrl} aria-label="Donghyeok Kim home">
        DONGHYEOK KIM
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href={homeUrl} aria-current={isHome ? "page" : undefined}>INDEX</a>
        <a href={profileUrl} aria-current={isProfile ? "page" : undefined}>CAREER</a>
        <a href={blogUrl} aria-current={isBlog ? "page" : undefined}>BLOG</a>
        <a href={analysisUrl} aria-current={isAnalysis ? "page" : undefined}>ANALYSIS</a>
        <a href={archiveUrl} aria-current={isArchive ? "page" : undefined}>ARCHIVE</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer page-shell">
      <div class="footer-meta">
        <p>© 2026 DONGHYEOK KIM</p>
        <a
          class="footer-email"
          href={`mailto:${contactEmail}`}
          aria-label={`Email Donghyeok Kim at ${contactEmail}`}
        >
          {contactEmail}
        </a>
      </div>
      <a class="back-to-top" href="#top" aria-label="페이지 맨 위로">
        BACK TO TOP ↑
      </a>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    --paper: #f7f4ee;
    --paper-deep: #ece7dd;
    --ink: #171814;
    --ink-soft: #4f514a;
    --ink-faint: #6b6e65;
    --accent: #a33a30;
    --rule: #d5d0c6;
    --page: 1200px;
    --gutter: clamp(20px, 4vw, 64px);
    --sans: "Inter", "Apple SD Gothic Neo", "Malgun Gothic", Arial, sans-serif;
    --serif: "Newsreader", "Noto Serif KR", "Batang", Georgia, serif;
    color-scheme: light;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--paper);
    color: var(--ink);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100svh;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-optical-sizing: auto;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  :global(img) {
    display: block;
    max-width: 100%;
  }

  :global(.page-shell) {
    width: min(calc(100% - (var(--gutter) * 2)), var(--page));
    margin-inline: auto;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 8px;
    left: 8px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 13px;
    text-decoration: none;
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    min-height: 76px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--sans);
  }

  .wordmark {
    justify-self: start;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    justify-self: end;
    gap: 12px;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--ink);
  }

  .site-nav a[aria-current="page"]::after {
    position: absolute;
    right: 6px;
    bottom: 5px;
    left: 6px;
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    min-height: 104px;
    border-top: 1px solid var(--ink);
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    align-items: center;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .footer-email {
    color: var(--ink-soft);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }

  .back-to-top {
    justify-self: end;
  }

  .site-footer a:hover {
    color: var(--ink);
  }

  .footer-email:hover {
    text-decoration-color: var(--accent);
  }

  @media (max-width: 800px) {
    .site-header {
      min-height: 68px;
    }

    .site-footer {
      min-height: 92px;
    }
  }

  @media (max-width: 420px) {
    .site-header {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 8px;
    }

    .wordmark {
      font-size: 9px;
      letter-spacing: 0.11em;
    }

    .site-nav {
      justify-content: flex-end;
      gap: 0;
    }

    .site-nav a {
      min-height: 40px;
      padding-inline: 3px;
      font-size: 7px;
      letter-spacing: 0.06em;
    }

    .site-footer {
      gap: 12px;
      padding-block: 12px;
    }

    .footer-meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-email {
      min-height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
