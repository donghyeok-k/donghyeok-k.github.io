---
interface Props {
  title: string;
  description: string;
  lang?: string;
  bodyClass?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  lang = "ko",
  bodyClass = "",
  ogType = "website",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const homeUrl = base;
const blogUrl = `${base}blog/`;
const isBlog = Astro.url.pathname.includes("/blog");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,700;6..72,800&family=Noto+Serif+KR:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <header class="site-header page-shell">
      <a class="wordmark" href={homeUrl} aria-label="Donghyeok Kim home">
        DONGHYEOK KIM
      </a>

      <div class="header-end">
        <p class="edition">A PERSONAL MONOGRAPH · 2026</p>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={homeUrl} aria-current={!isBlog ? "page" : undefined}>INDEX</a>
          <a href={blogUrl} aria-current={isBlog ? "page" : undefined}>JOURNAL</a>
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>

<style>
  :global(:root) {
    --paper: #faf7f1;
    --paper-deep: #f2ede4;
    --ink: #191817;
    --ink-soft: #4c4a46;
    --ink-faint: #6f6b64;
    --crimson: #a51c30;
    --rule: #dcd6ca;
    --page: 1240px;
    --sans: "Inter", "Apple SD Gothic Neo", "Malgun Gothic", Arial, sans-serif;
    --serif: "Newsreader", "Noto Serif KR", "Batang", Georgia, serif;
    color-scheme: light;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--paper);
    color: var(--ink);
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100svh;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    text-rendering: optimizeLegibility;
    font-optical-sizing: auto;
  }

  :global(a) {
    color: inherit;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--crimson);
    outline-offset: 5px;
  }

  :global(img) {
    display: block;
    max-width: 100%;
  }

  :global(.page-shell) {
    width: min(calc(100% - 56px), var(--page));
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
    padding-top: 27px;
    border-bottom: 2px solid var(--ink);
    font-family: var(--sans);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    min-height: 24px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-decoration: none;
  }

  .header-end,
  .site-nav {
    display: flex;
    align-items: baseline;
  }

  .header-end {
    gap: 28px;
  }

  .edition {
    margin: 0;
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .site-nav {
    gap: 18px;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 4px 2px;
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-decoration: none;
  }

  .site-nav a[aria-current="page"],
  .site-nav a:hover {
    color: var(--ink);
  }

  .site-nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--crimson);
    content: "";
  }

  @media (max-width: 760px) {
    :global(.page-shell) {
      width: min(calc(100% - 36px), var(--page));
    }

    .site-header {
      height: 58px;
      padding-top: 21px;
    }

    .edition {
      display: none;
    }

    .header-end {
      gap: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      scroll-behavior: auto !important;
    }
  }
</style>
