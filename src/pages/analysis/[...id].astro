---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const notes = await getCollection("analysis", ({ data }) => !data.draft);

  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<"analysis">;
}

const { note } = Astro.props;
const { Content } = await render(note);
const base = import.meta.env.BASE_URL;
const analysisUrl = `${base}analysis/`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "Asia/Seoul",
  }).format(date);
---

<SiteLayout
  title={`${note.data.title} — Donghyeok Kim`}
  description={note.data.description}
  bodyClass="analysis-note-page"
  ogType="article"
  publishedTime={note.data.pubDate}
  modifiedTime={note.data.updatedDate}
  tags={note.data.tags}
>
  <main id="content" class="note page-shell">
    <div class="note-nav">
      <a href={analysisUrl}><span aria-hidden="true">←</span> ANALYSIS</a>
      <p>{note.data.series.toUpperCase()} / {String(note.data.order).padStart(2, "0")}</p>
    </div>

    <header class="note-header">
      <p class="note-index">{note.data.series.toUpperCase()}</p>
      <div>
        <h1>{note.data.title}</h1>
        <p>{note.data.description}</p>
      </div>
      <time datetime={note.data.pubDate.toISOString()}>{formatDate(note.data.pubDate)}</time>
    </header>

    <article class="prose">
      <Content />
    </article>

    <footer class="note-footer">
      <p>정의의 전제와 결론의 범위를 분명히 읽습니다.</p>
      <a href={analysisUrl}>목록으로 돌아가기 <span aria-hidden="true">→</span></a>
    </footer>
  </main>
</SiteLayout>

<style>
  .note {
    padding: 30px 0 clamp(96px, 12vw, 152px);
  }

  .note-nav,
  .note-index,
  .note-header > div > p,
  .note-header time,
  .note-footer {
    font-family: var(--sans);
  }

  .note-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    min-height: 44px;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .note-nav a,
  .note-footer a {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .note-nav span,
  .note-footer span {
    color: var(--accent);
    font-size: 14px;
  }

  .note-nav p {
    margin: 0;
  }

  .note-header {
    display: grid;
    grid-template-columns: 2fr minmax(0, 7fr) 2fr;
    gap: clamp(16px, 3vw, 38px);
    align-items: start;
    padding: clamp(64px, 8vw, 104px) 0;
    border-bottom: 1px solid var(--ink);
  }

  .note-index,
  .note-header time {
    margin: 6px 0 0;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .note-header h1 {
    margin: 0;
    font-size: clamp(35px, 5.2vw, 66px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.95;
    word-break: keep-all;
  }

  .note-header > div > p {
    margin: 26px 0 0;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.7;
    word-break: keep-all;
  }

  .note-header time {
    justify-self: end;
    color: var(--ink-faint);
  }

  .prose {
    width: min(100%, 720px);
    margin: clamp(56px, 8vw, 96px) auto 0;
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.9;
    word-break: keep-all;
  }

  .prose :global(h2) {
    margin: clamp(52px, 7vw, 76px) 0 20px;
    font-size: clamp(28px, 3.5vw, 40px);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .prose :global(p) {
    margin: 0 0 22px;
  }

  .prose :global(ol) {
    margin: 24px 0;
    padding-left: 1.4em;
  }

  .prose :global(li) {
    margin: 9px 0;
  }

  .prose :global(blockquote) {
    margin: 34px 0;
    padding: 20px 24px;
    border-left: 2px solid var(--accent);
    background: var(--paper-deep);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.85em;
    line-height: 1.75;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .note-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    width: min(100%, 720px);
    margin: clamp(72px, 10vw, 116px) auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
    color: var(--ink-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .note-footer p {
    margin: 0;
  }

  @media (max-width: 700px) {
    .note-header {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .note-header time {
      justify-self: start;
      margin: 0;
    }

    .note-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
