---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "Asia/Seoul",
  }).format(date);
---

<SiteLayout
  title="Journal — Donghyeok Kim"
  description="AI, 연구, 사고법을 편집하고 연결하는 김동혁의 기록."
  bodyClass="journal-page"
>
  <main class="journal page-shell">
    <section class="journal-intro" aria-labelledby="journal-title">
      <p class="eyebrow">WRITING / NOTES</p>
      <h1 id="journal-title">생각을 편집하는 기록</h1>
      <p class="intro-copy">
        완성된 답보다 질문이 변해가는 과정을 기록합니다.<br />
        AI, 연구, 그리고 서로 다른 지식을 연결하는 방법에 관하여.
      </p>
    </section>

    <section class="post-list" aria-label="글 목록">
      {
        posts.map((post, index) => {
          const postUrl = `${base}blog/${post.id}/`;
          const imageUrl = post.data.heroImage
            ? `${base}${post.data.heroImage.replace(/^\//, "")}`
            : undefined;

          return (
            <article class="post-card">
              <p class="post-number">{String(index + 1).padStart(2, "0")}</p>

              <div class="post-copy">
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span>{post.data.tags.join(" · ")}</span>
                </div>

                <h2><a href={postUrl}>{post.data.title}</a></h2>
                <p class="post-description">{post.data.description}</p>
                <a class="read-link" href={postUrl} aria-label={`${post.data.title} 읽기`}>
                  READ ENTRY <span aria-hidden="true">→</span>
                </a>
              </div>

              {
                imageUrl && (
                  <a class="post-image" href={postUrl} tabindex="-1" aria-hidden="true">
                    <img
                      src={imageUrl}
                      alt=""
                      width="1536"
                      height="1024"
                      loading="lazy"
                    />
                  </a>
                )
              }
            </article>
          );
        })
      }
    </section>
  </main>
</SiteLayout>

<style>
  .journal {
    padding: clamp(64px, 10vw, 132px) 0 96px;
  }

  .journal-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.8fr);
    gap: 64px;
    align-items: end;
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .eyebrow,
  .post-meta,
  .post-number,
  .read-link {
    font-family: var(--sans);
  }

  .eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 -38px;
    color: var(--crimson);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(52px, 7vw, 92px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    word-break: keep-all;
  }

  .intro-copy {
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.85;
  }

  .post-list {
    border-top: 2px solid var(--ink);
  }

  .post-card {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(220px, 32%);
    gap: clamp(24px, 4vw, 56px);
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }

  .post-number {
    margin: 4px 0 0;
    color: var(--crimson);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .post-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 18px;
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  h2 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(30px, 3.4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.16;
    word-break: keep-all;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--crimson);
  }

  .post-description {
    max-width: 680px;
    margin: 18px 0 28px;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.75;
    word-break: keep-all;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding-block: 6px;
    margin-top: auto;
    color: var(--ink);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-decoration: none;
  }

  .read-link span {
    display: inline-block;
    margin-left: 7px;
    color: var(--crimson);
    transition: transform 160ms ease;
  }

  .read-link:hover span {
    transform: translateX(4px);
  }

  .post-image {
    align-self: stretch;
    min-height: 220px;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.78;
    mix-blend-mode: multiply;
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .post-image:hover img {
    transform: scale(1.025);
    opacity: 0.9;
  }

  @media (max-width: 760px) {
    .journal {
      padding: 52px 0 64px;
    }

    .journal-intro {
      display: block;
      padding-bottom: 54px;
    }

    .eyebrow {
      margin: 0 0 18px;
    }

    h1 {
      font-size: clamp(45px, 13vw, 66px);
    }

    .intro-copy {
      margin-top: 30px;
    }

    .post-card {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 18px;
      padding: 26px 0 34px;
    }

    .post-image {
      grid-column: 2;
      grid-row: 2;
      min-height: 180px;
      margin-top: 6px;
    }

    .post-description {
      margin-bottom: 22px;
    }
  }
</style>
