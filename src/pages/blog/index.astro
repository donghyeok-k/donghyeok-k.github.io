---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Seoul",
  }).format(date);
---

<SiteLayout
  title="Journal — Donghyeok Kim"
  description="AI, 연구, 사고법을 편집하고 연결하는 김동혁의 기록."
  bodyClass="journal-page"
>
  <main id="content" class="journal page-shell">
    <section class="journal-intro" aria-labelledby="journal-title">
      <p class="page-index">01 / JOURNAL</p>
      <div class="title-group">
        <p class="eyebrow">WRITING &amp; NOTES</p>
        <h1 id="journal-title">생각을 편집하는<br />기록.</h1>
      </div>
      <p class="intro-copy">
        완성된 답보다 질문이 변해가는 과정을 기록합니다. AI, 연구, 그리고
        서로 다른 지식을 연결하는 방법에 관하여.
      </p>
    </section>

    <section class="entries" aria-labelledby="entries-title">
      <header class="entries-header">
        <h2 id="entries-title">ALL ENTRIES</h2>
        <p>{String(posts.length).padStart(2, "0")} NOTES</p>
      </header>

      <div class="post-list">
        {
          posts.map((post, index) => {
            const postUrl = `${base}blog/${post.id}/`;

            return (
              <article class="post-row">
                <p class="post-number">{String(index + 1).padStart(2, "0")}</p>

                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <p>{post.data.tags.slice(0, 3).join(" · ")}</p>
                </div>

                <div class="post-copy">
                  <h3><a href={postUrl}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                </div>

                <a class="read-link" href={postUrl} aria-label={`${post.data.title} 읽기`}>
                  <span>READ</span>
                  <b aria-hidden="true">→</b>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>

    <aside class="journal-note" aria-label="Journal note">
      <p>ABOUT THIS JOURNAL</p>
      <blockquote>
        생성된 것의 양보다,<br />끝까지 남겨진 것의 이유를 묻습니다.
      </blockquote>
    </aside>
  </main>
</SiteLayout>

<style>
  .journal {
    padding: clamp(72px, 9vw, 120px) 0 clamp(88px, 11vw, 144px);
  }

  .journal-intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: end;
    padding-bottom: clamp(80px, 10vw, 128px);
  }

  .page-index,
  .eyebrow,
  .intro-copy,
  .entries-header,
  .post-number,
  .post-meta,
  .read-link,
  .journal-note > p {
    font-family: var(--sans);
  }

  .page-index {
    grid-column: 1 / 3;
    align-self: start;
    margin: 4px 0 0;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .title-group {
    grid-column: 3 / 9;
  }

  .eyebrow {
    margin: 0 0 22px;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 5.5vw, 68px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.06;
    word-break: keep-all;
  }

  .intro-copy {
    grid-column: 9 / 13;
    max-width: 360px;
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.8;
    word-break: keep-all;
  }

  .entries {
    border-top: 1px solid var(--ink);
  }

  .entries-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .entries-header h2,
  .entries-header p {
    margin: 0;
    font: inherit;
  }

  .post-list {
    border-top: 1px solid var(--rule);
  }

  .post-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: start;
    padding: clamp(32px, 4.5vw, 56px) 0;
    border-bottom: 1px solid var(--rule);
  }

  .post-number {
    grid-column: 1;
    margin: 4px 0 0;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .post-meta {
    grid-column: 2 / 4;
    margin: 4px 0 0;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.05em;
  }

  .post-meta p {
    margin: 10px 0 0;
  }

  .post-copy {
    grid-column: 4 / 11;
    max-width: 680px;
  }

  .post-copy h3 {
    margin: 0;
    font-size: clamp(31px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.28;
    word-break: keep-all;
  }

  .post-copy h3 a {
    text-decoration: none;
  }

  .post-copy h3 a:hover {
    color: var(--accent);
  }

  .post-copy > p {
    margin: 20px 0 0;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.75;
    word-break: keep-all;
  }

  .read-link {
    grid-column: 11 / 13;
    justify-self: end;
    display: inline-flex;
    gap: 12px;
    align-items: center;
    min-height: 44px;
    margin-top: -9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .read-link b {
    color: var(--accent);
    font-size: 14px;
    transition: transform 160ms ease;
  }

  .read-link:hover b {
    transform: translateX(4px);
  }

  .journal-note {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.2vw, 32px);
    padding-top: clamp(72px, 9vw, 112px);
  }

  .journal-note > p {
    grid-column: 1 / 4;
    margin: 5px 0 0;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .journal-note blockquote {
    grid-column: 4 / 11;
    margin: 0;
    font-size: clamp(29px, 3.7vw, 46px);
    font-style: italic;
    letter-spacing: -0.035em;
    line-height: 1.45;
    word-break: keep-all;
  }

  @media (max-width: 1024px) {
    .journal-intro {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .page-index {
      grid-column: 1;
    }

    .title-group {
      grid-column: 2 / 6;
    }

    .intro-copy {
      grid-column: 6 / 9;
    }

    .post-number {
      grid-column: 1;
    }

    .post-meta {
      grid-column: 2 / 5;
    }

    .post-copy {
      grid-column: 5 / 11;
    }
  }

  @media (max-width: 760px) {
    .journal {
      padding: 56px 0 88px;
    }

    .journal-intro {
      display: block;
      padding-bottom: 72px;
    }

    .page-index {
      margin-bottom: 42px;
    }

    .eyebrow {
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(42px, 12vw, 54px);
    }

    .intro-copy {
      max-width: 520px;
      margin-top: 42px;
    }

    .entries-header {
      min-height: 62px;
    }

    .post-row {
      display: block;
      padding: 30px 0 36px;
    }

    .post-number {
      margin-bottom: 18px;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      margin: 0 0 20px;
    }

    .post-meta p {
      margin: 0;
    }

    .post-copy h3 {
      font-size: clamp(28px, 8.5vw, 36px);
    }

    .read-link {
      justify-self: start;
      margin: 18px 0 0;
    }

    .journal-note {
      display: block;
      padding-top: 72px;
    }

    .journal-note blockquote {
      margin-top: 28px;
      font-size: clamp(28px, 8.5vw, 36px);
    }
  }

</style>
