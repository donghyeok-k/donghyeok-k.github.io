---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsByYear = new Map<string, typeof posts>();

for (const post of posts) {
  const year = new Intl.DateTimeFormat("en", {
    year: "numeric",
    timeZone: "Asia/Seoul",
  }).format(post.data.pubDate);
  const group = postsByYear.get(year) ?? [];
  group.push(post);
  postsByYear.set(year, group);
}

const base = import.meta.env.BASE_URL;
const showSearch = posts.length >= 8;
const formatShortDate = (date: Date) =>
  new Intl.DateTimeFormat("ko-KR", {
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Seoul",
  })
    .format(date)
    .replace(/\s/g, "");
---

<SiteLayout
  title="Writing — Donghyeok Kim"
  description="AI, 연구, 사고법을 편집하고 연결하는 김동혁의 글."
  bodyClass="journal-page"
>
  <main id="content" class="journal page-shell">
    <div class="journal-inner">
      <header class="journal-header">
        <p class="eyebrow">WRITING / {String(posts.length).padStart(2, "0")}</p>
        <h1>Writing</h1>
        <p class="journal-description">
          AI, 연구, 그리고 서로 다른 지식을 연결하는 방법에 관한 기록.
        </p>
      </header>

      {
        showSearch && (
          <div class="archive-tools">
            <label for="post-search">글 찾기</label>
            <div class="search-field">
              <input
                id="post-search"
                type="search"
                placeholder="제목이나 주제 검색"
                autocomplete="off"
                data-post-search
              />
              <span aria-hidden="true">⌕</span>
            </div>
            <p class="search-status" aria-live="polite" data-search-status />
          </div>
        )
      }

      <div class="archive" data-post-archive>
        {
          Array.from(postsByYear).map(([year, yearPosts]) => (
            <section class="year-group" data-year-group aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`}>{year}</h2>

              <ol class="post-list">
                {yearPosts.map((post) => {
                  const postUrl = `${base}blog/${post.id}/`;
                  const searchableText = [
                    post.data.title,
                    post.data.description,
                    ...post.data.tags,
                  ]
                    .join(" ")
                    .toLocaleLowerCase("ko");

                  return (
                    <li class="post-item" data-post-row data-search={searchableText}>
                      <a
                        href={postUrl}
                        aria-labelledby={`post-date-${post.id} post-title-${post.id}`}
                        aria-describedby={`post-summary-${post.id}`}
                      >
                        <time
                          id={`post-date-${post.id}`}
                          datetime={post.data.pubDate.toISOString()}
                        >
                          {formatShortDate(post.data.pubDate)}
                        </time>

                        <div class="post-copy">
                          <h3 id={`post-title-${post.id}`} class="post-title">
                            {post.data.title}
                          </h3>
                          <p id={`post-summary-${post.id}`} class="post-summary">
                            {post.data.description}
                          </p>
                        </div>

                        <span class="post-arrow" aria-hidden="true">↗</span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </section>
          ))
        }
      </div>

      <p class="empty-state" hidden data-empty-state>
        일치하는 글이 없습니다.
      </p>
    </div>
  </main>
</SiteLayout>

<script is:inline>
  const searchInput = document.querySelector("[data-post-search]");

  if (searchInput instanceof HTMLInputElement) {
    const rows = Array.from(document.querySelectorAll("[data-post-row]"));
    const groups = Array.from(document.querySelectorAll("[data-year-group]"));
    const status = document.querySelector("[data-search-status]");
    const emptyState = document.querySelector("[data-empty-state]");

    searchInput.addEventListener("input", () => {
      const query = searchInput.value.trim().toLocaleLowerCase("ko");
      let visibleCount = 0;

      for (const row of rows) {
        if (!(row instanceof HTMLElement)) continue;
        const matches = !query || (row.dataset.search ?? "").includes(query);
        row.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      for (const group of groups) {
        if (!(group instanceof HTMLElement)) continue;
        group.hidden = !group.querySelector("[data-post-row]:not([hidden])");
      }

      if (status) {
        status.textContent = query ? `${visibleCount}개의 글` : "";
      }
      if (emptyState instanceof HTMLElement) {
        emptyState.hidden = visibleCount !== 0;
      }
    });
  }
</script>

<style>
  .journal {
    padding: clamp(64px, 8vw, 104px) 0 clamp(96px, 12vw, 152px);
  }

  .journal-inner {
    width: min(100%, var(--content-wide));
    margin-inline: auto;
  }

  .journal-header {
    max-width: 680px;
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .eyebrow,
  .journal-description,
  .archive-tools,
  .year-group h2,
  .post-item,
  .empty-state {
    font-family: var(--sans);
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 5.5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .journal-description {
    max-width: 540px;
    margin: 22px 0 0;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.75;
    word-break: keep-all;
  }

  .archive-tools {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid var(--ink);
  }

  .archive-tools label {
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .search-field {
    position: relative;
  }

  .search-field input {
    width: 100%;
    height: 44px;
    padding: 0 34px 0 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: 14px/1 var(--sans);
  }

  .search-field input:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .search-field span {
    position: absolute;
    top: 50%;
    right: 4px;
    color: var(--ink-faint);
    font-size: 18px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-status {
    grid-column: 2;
    min-height: 1em;
    margin: 8px 0 0;
    color: var(--ink-faint);
    font-size: 10px;
  }

  .archive {
    border-top: 1px solid var(--ink);
  }

  .year-group {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    border-bottom: 1px solid var(--ink);
  }

  .year-group h2 {
    position: sticky;
    top: 92px;
    align-self: start;
    margin: 0;
    padding: 22px 0;
    color: var(--ink-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .post-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-item {
    border-bottom: 1px solid var(--rule);
  }

  .post-item:last-child {
    border-bottom: 0;
  }

  .post-item a {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) 22px;
    gap: 18px;
    align-items: center;
    min-height: 60px;
    padding: 8px 4px;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }

  .post-item time {
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .post-copy {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    height: 44px;
    overflow: hidden;
  }

  .post-title {
    width: 100%;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 160ms ease, transform 160ms ease;
  }

  .post-summary {
    position: absolute;
    right: 0;
    bottom: 1px;
    left: 0;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 11px;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(5px);
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .post-arrow {
    justify-self: end;
    color: transparent;
    font-size: 13px;
    transition: color 160ms ease, transform 160ms ease;
  }

  .post-item a:focus-visible {
    background: var(--paper-deep);
    box-shadow: inset 2px 0 var(--accent);
  }

  .post-item a:focus-visible .post-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (min-width: 641px) {
    .post-item a:focus-visible .post-title {
      color: var(--accent);
      transform: translateY(-8px);
    }

    .post-item a:focus-visible .post-summary {
      opacity: 1;
      transform: translateY(0);
    }

    .post-item a:hover {
      background: var(--paper-deep);
      box-shadow: inset 2px 0 var(--accent);
    }

    .post-item a:hover .post-title,
    .post-item a:hover .post-arrow {
      color: var(--accent);
    }

    .post-item a:hover .post-title {
      transform: translateY(-8px);
    }

    .post-item a:hover .post-summary {
      opacity: 1;
      transform: translateY(0);
    }

    .post-item a:hover .post-arrow {
      transform: translate(2px, -2px);
    }
  }

  .empty-state {
    margin: 0;
    padding: 44px 0;
    border-bottom: 1px solid var(--ink);
    color: var(--ink-faint);
    font-size: 13px;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 640px) {
    .journal {
      padding: 54px 0 96px;
    }

    .journal-header {
      padding-bottom: 48px;
    }

    h1 {
      font-size: clamp(44px, 13vw, 54px);
    }

    .journal-description {
      margin-top: 18px;
      font-size: 13px;
    }

    .archive-tools {
      display: block;
    }

    .archive-tools label {
      display: block;
      margin-bottom: 8px;
    }

    .search-status {
      min-height: 0;
    }

    .year-group {
      display: block;
    }

    .year-group h2 {
      position: static;
      padding: 18px 4px 12px;
      border-bottom: 1px solid var(--rule);
    }

    .post-item a {
      grid-template-columns: 52px minmax(0, 1fr) 18px;
      gap: 12px;
      min-height: 64px;
      padding: 14px 4px;
    }

    .post-copy {
      display: block;
      height: auto;
      overflow: visible;
    }

    .post-title {
      font-size: clamp(19px, 5.2vw, 22px);
      line-height: 1.35;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      word-break: keep-all;
      overflow-wrap: anywhere;
      transform: none;
    }

    .post-summary {
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .post-arrow {
      color: var(--ink-faint);
    }

  }

  @media (max-width: 360px) {
    .post-item a {
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 10px;
    }

    .post-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-item a,
    .post-title,
    .post-summary,
    .post-arrow {
      transition: none;
    }
  }
</style>
