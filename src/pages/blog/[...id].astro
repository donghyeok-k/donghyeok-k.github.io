---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const blogUrl = `${base}blog/`;
const imageUrl = post.data.heroImage
  ? `${base}${post.data.heroImage.replace(/^\//, "")}`
  : undefined;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "Asia/Seoul",
  }).format(date);
---

<SiteLayout
  title={`${post.data.title} — Donghyeok Kim`}
  description={post.data.description}
  bodyClass="article-page"
  ogType="article"
>
  <main class="article page-shell">
    <a class="back-link" href={blogUrl}>
      <span aria-hidden="true">←</span> ALL ENTRIES
    </a>

    <header class="article-header">
      <div class="article-meta">
        <p>ENTRY / {post.data.tags[0] ?? "NOTE"}</p>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </div>

      <h1>{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>

      <ul class="tag-list" aria-label="태그">
        {post.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    {
      imageUrl && (
        <figure class="hero-image">
          <img
            src={imageUrl}
            alt={post.data.heroAlt ?? ""}
            width="1536"
            height="1024"
          />
        </figure>
      )
    }

    <div class="article-grid">
      <aside class="article-side" aria-label="Article information">
        <p>WRITTEN BY</p>
        <strong>Donghyeok Kim</strong>
        <span>A personal note on<br />editing and inquiry.</span>
      </aside>

      <article class="prose">
        <Content />
      </article>
    </div>

    <footer class="article-footer">
      <p>끝까지 남겨진 것의 이유를 묻습니다.</p>
      <a href={blogUrl}>다른 기록 보기 <span aria-hidden="true">→</span></a>
    </footer>
  </main>
</SiteLayout>

<style>
  .article {
    padding: 38px 0 96px;
  }

  .back-link,
  .article-meta,
  .tag-list,
  .article-side,
  .article-footer {
    font-family: var(--sans);
  }

  .back-link {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    min-height: 28px;
    padding-block: 6px;
    margin: 0 0 clamp(64px, 9vw, 112px);
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-decoration: none;
  }

  .back-link span {
    color: var(--crimson);
    font-size: 14px;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .article-header {
    width: min(100%, 1040px);
    margin: 0 auto;
    text-align: center;
  }

  .article-meta {
    display: flex;
    justify-content: center;
    gap: 18px;
    align-items: center;
    margin-bottom: 28px;
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }

  .article-meta p {
    margin: 0;
    color: var(--crimson);
    font-weight: 700;
  }

  .article-meta p::after {
    display: inline-block;
    width: 28px;
    height: 1px;
    margin-left: 18px;
    vertical-align: middle;
    background: var(--rule);
    content: "";
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 7.2vw, 92px);
    font-weight: 700;
    letter-spacing: -0.052em;
    line-height: 1.06;
    word-break: keep-all;
  }

  .article-dek {
    max-width: 720px;
    margin: 30px auto 0;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.8;
    word-break: keep-all;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 7px 11px 6px;
    border: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .hero-image {
    height: clamp(320px, 52vw, 650px);
    margin: clamp(60px, 8vw, 100px) 0 0;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.78;
    mix-blend-mode: multiply;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 180px minmax(0, 720px);
    gap: clamp(48px, 8vw, 112px);
    justify-content: center;
    padding: clamp(70px, 10vw, 128px) 0;
  }

  .article-side {
    padding-top: 8px;
    color: var(--ink-faint);
    font-size: 9px;
    line-height: 1.65;
    letter-spacing: 0.12em;
  }

  .article-side p {
    margin: 0 0 14px;
    color: var(--crimson);
    font-weight: 700;
  }

  .article-side strong,
  .article-side span {
    display: block;
  }

  .article-side strong {
    margin-bottom: 18px;
    color: var(--ink);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .prose {
    min-width: 0;
    color: #302f2c;
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.95;
    word-break: keep-all;
  }

  .prose :global(p) {
    margin: 0 0 1.65em;
  }

  .prose :global(p:first-child) {
    font-size: 1.12em;
    line-height: 1.85;
  }

  .prose :global(p:first-child::first-letter) {
    float: left;
    margin: 0.06em 0.1em 0 0;
    color: var(--crimson);
    font-family: var(--serif);
    font-size: 3.5em;
    font-weight: 700;
    line-height: 0.82;
  }

  .prose :global(h2) {
    margin: 3.2em 0 1em;
    padding-top: 0.8em;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    font-size: clamp(28px, 3.3vw, 42px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(a) {
    text-decoration-color: var(--crimson);
    text-underline-offset: 0.18em;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    font-size: 11px;
  }

  .article-footer p {
    margin: 0;
    color: var(--ink-soft);
  }

  .article-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding-block: 6px;
    font-weight: 700;
    text-decoration: none;
  }

  .article-footer a span {
    margin-left: 8px;
    color: var(--crimson);
  }

  @media (max-width: 760px) {
    .article {
      padding: 28px 0 64px;
    }

    .back-link {
      margin-bottom: 54px;
    }

    .article-meta {
      flex-direction: column;
      gap: 8px;
    }

    .article-meta p::after {
      display: none;
    }

    h1 {
      font-size: clamp(43px, 12.5vw, 62px);
    }

    .article-dek {
      margin-top: 24px;
      font-size: 14px;
    }

    .hero-image {
      height: 66vw;
      margin-top: 54px;
    }

    .article-grid {
      display: block;
      padding: 58px 0 68px;
    }

    .article-side {
      display: none;
    }

    .prose {
      font-size: 17px;
      line-height: 1.9;
    }

    .prose :global(h2) {
      margin-top: 2.6em;
    }

    .article-footer {
      display: block;
    }

    .article-footer a {
      display: inline-block;
      margin-top: 14px;
    }
  }
</style>
