---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const blogUrl = `${base}blog/`;
const imageUrl = post.data.heroImage
  ? `${base}${post.data.heroImage.replace(/^\//, "")}`
  : undefined;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "Asia/Seoul",
  }).format(date);
---

<SiteLayout
  title={`${post.data.title} — Donghyeok Kim`}
  description={post.data.description}
  bodyClass="article-page"
  ogType="article"
  image={post.data.heroImage}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
>
  <main id="content" class="article page-shell">
    <div class="article-nav">
      <a href={blogUrl}><span aria-hidden="true">←</span> WRITING</a>
      <p>ENTRY / {post.data.tags[0] ?? "NOTE"}</p>
    </div>

    <header class="article-header">
      <p class="article-index">WRITING / ESSAY</p>

      <div class="title-group">
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.description}</p>
      </div>

      <div class="article-meta">
        <p>PUBLISHED</p>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <ul aria-label="태그">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </header>

    {
      imageUrl && (
        <figure class="hero-image">
          <img
            src={imageUrl}
            alt={post.data.heroAlt ?? ""}
            width="1536"
            height="1024"
          />
        </figure>
      )
    }

    <article class="prose">
      <Content />
    </article>

    <footer class="article-footer">
      <p>끝까지 남겨진 것의 이유를 묻습니다.</p>
      <a href={blogUrl}>다른 기록 보기 <span aria-hidden="true">→</span></a>
    </footer>
  </main>
</SiteLayout>

<style>
  .article {
    padding: 30px 0 clamp(96px, 12vw, 152px);
  }

  .article-nav,
  .article-index,
  .article-dek,
  .article-meta,
  .article-footer {
    font-family: var(--sans);
  }

  .article-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .article-nav,
  .article-header {
    width: min(100%, var(--content-wide));
    margin-inline: auto;
  }

  .article-nav a {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .article-nav a span {
    color: var(--accent);
    font-size: 14px;
  }

  .article-nav a:hover {
    color: var(--ink);
  }

  .article-nav p {
    margin: 0;
  }

  .article-header {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: start;
    padding: clamp(64px, 8vw, 104px) 0 clamp(64px, 8vw, 104px);
    border-bottom: 1px solid var(--ink);
  }

  .article-index {
    grid-column: 1 / 3;
    margin: 5px 0 0;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .title-group {
    grid-column: 3 / 10;
  }

  h1 {
    margin: 0;
    font-size: clamp(43px, 5.2vw, 64px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.15;
    word-break: keep-all;
  }

  .article-dek {
    max-width: 620px;
    margin: 28px 0 0;
    color: var(--ink-soft);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.8;
    word-break: keep-all;
  }

  .article-meta {
    grid-column: 10 / 13;
    margin-top: 7px;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.65;
    letter-spacing: 0.06em;
  }

  .article-meta > p {
    margin: 0 0 9px;
    color: var(--accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .article-meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-image {
    width: min(100%, 960px);
    margin: clamp(56px, 7vw, 88px) auto 0;
  }

  .hero-image img {
    width: 100%;
    height: auto;
  }

  .prose {
    width: min(100%, 42rem);
    margin: 0 auto;
    padding: clamp(64px, 8vw, 96px) 0 clamp(80px, 10vw, 120px);
    color: #30312d;
    font-size: clamp(17px, 1.15vw, 18px);
    line-height: 1.78;
    word-break: keep-all;
  }

  .prose :global(p) {
    margin: 0 0 1.55em;
  }

  .prose :global(p:first-child) {
    color: var(--ink);
    font-size: 1.08em;
  }

  .prose :global(h2) {
    position: relative;
    margin: 2.7em 0 0.9em;
    padding-top: 0.75em;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    font-size: clamp(27px, 2.8vw, 34px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.38;
  }

  .prose :global(h2::before) {
    position: absolute;
    top: -1px;
    left: 0;
    width: 36px;
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(a) {
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .prose :global(blockquote) {
    margin: 2.5em 0;
    padding-left: 1.2em;
    border-left: 2px solid var(--accent);
    color: var(--ink-soft);
    font-style: italic;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(100%, 42rem);
    margin: 0 auto;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
    font-size: 11px;
  }

  .article-footer p {
    margin: 0;
    color: var(--ink-soft);
  }

  .article-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
  }

  .article-footer a span {
    margin-left: 8px;
    color: var(--accent);
  }

  @media (max-width: 1024px) {
    .article-header {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .article-index {
      grid-column: 1;
    }

    .title-group {
      grid-column: 2 / 7;
    }

    .article-meta {
      grid-column: 7 / 9;
    }
  }

  @media (max-width: 760px) {
    .article {
      padding-top: 18px;
    }

    .article-nav p {
      display: none;
    }

    .article-header {
      display: block;
      padding: 48px 0 56px;
    }

    .article-index {
      margin-bottom: 28px;
    }

    h1 {
      font-size: clamp(39px, 11.7vw, 50px);
      line-height: 1.16;
    }

    .article-dek {
      margin-top: 24px;
      font-size: 15px;
    }

    .article-meta {
      margin-top: 36px;
      padding-top: 18px;
      border-top: 1px solid var(--rule);
    }

    .article-meta ul {
      margin-top: 12px;
    }

    .hero-image {
      margin-top: 48px;
    }

    .prose {
      padding: 56px 0 80px;
      font-size: 17px;
      line-height: 1.76;
    }

    .prose :global(h2) {
      margin-top: 2.35em;
      font-size: clamp(26px, 8vw, 32px);
    }

    .article-footer {
      display: block;
    }

    .article-footer a {
      margin-top: 12px;
    }
  }
</style>
