---
import SiteLayout from "../layouts/SiteLayout.astro";
import WikiDriveLogo from "../components/WikiDriveLogo.astro";
import { archiveItems } from "../data/archive";
import { researchProjects } from "../data/research";
import { projects } from "../data/projects";

const base = import.meta.env.BASE_URL;
const title = "Career & Activities — Donghyeok Kim";
const description =
  "Donghyeok Kim's education, research interests, projects, honors and public activities — undergraduate researcher at KENTECH and CEO of WikiDrive.";
const projectHost = (url: string) => new URL(url).host;

const timeline = [
  {
    period: "2022 — PRESENT",
    role: "Undergraduate, KENTECH",
    organization: "Korea Institute of Energy Technology · Inaugural class",
    description:
      "Studying quantitative analysis that explains real problems, centered on energy systems, carbon markets and computational modeling.",
  },
  {
    period: "2023 — 2024",
    role: "President, 2nd KENTECH Student Council",
    organization: "KENTECH Student Council",
    description:
      "Represented the student body and organized exchanges, community partnerships and campus programs, building collaboration on and off campus.",
  },
];

const honors = [
  {
    period: "2023",
    title: "Presidential Award for Meritorious Service",
    issuer: "KENTECH",
  },
  {
    period: "2023",
    title: "Second Prize, KENTECH Video Contest",
    issuer: "KENTECH · Dean of Student Affairs Award",
  },
  {
    period: "2022",
    title: "Commendation from the Mayor of Naju",
    issuer: "Naju City",
    detail: "For outstanding mentoring",
  },
  {
    period: "2022 — PRESENT",
    title: "KENTECH Presidential Scholarship",
    issuer: "KENTECH",
    detail: "Full scholarship for academic excellence",
  },
];

const featuredActivities = archiveItems.filter((item) =>
  ["stadium-2023", "naju-pear-2023", "summer-campus-2023", "energyverse-2023"].includes(
    item.id,
  ),
);
---

<SiteLayout
  title={title}
  description={description}
  bodyClass="career-page"
  profilePage={true}
>
  <main id="content" class="career page-shell">
    <header class="career-header">
      <p class="eyebrow">CAREER / DONGHYEOK KIM</p>
      <h1>Career &amp;<br />Activities</h1>
      <p class="intro">
        Fourth-year undergraduate researcher, KENTECH<br />
        Energy Systems · Carbon Markets · Computational Modeling<br />
        CEO, WikiDrive
      </p>
    </header>

    <section class="section" aria-labelledby="career-heading">
      <div class="section-label">
        <h2 id="career-heading">Career</h2>
        <span>01</span>
      </div>
      <ol class="timeline">
        {timeline.map((item) => (
          <li>
            <time>{item.period}</time>
            <div>
              <h3>{item.role}</h3>
              <p class="organization">{item.organization}</p>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="projects-heading">
      <div class="section-label">
        <h2 id="projects-heading">Projects</h2>
        <span>02</span>
      </div>
      <ol class="timeline">
        {projects.map((project) => (
          <li id={project.id}>
            <time>{project.period}</time>
            <div>
              <h3>{project.id === "wikidrive" ? <WikiDriveLogo /> : project.name}</h3>
              <p class="organization">{project.role}</p>
              <p>{project.tagline} {project.description}</p>
              <a class="project-link" href={project.url}>Visit {projectHost(project.url)} <span aria-hidden="true">↗</span></a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="research-heading">
      <div class="section-label">
        <h2 id="research-heading">Research in Progress</h2>
        <span>03</span>
      </div>
      <ol class="honors research-records">
        {researchProjects.map((project) => (
          <li id={project.id}>
            <time>2026</time>
            <div>
              <h3>{project.title}</h3>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="honors-heading">
      <div class="section-label">
        <h2 id="honors-heading">Honors &amp; Awards</h2>
        <span>04</span>
      </div>
      <ol class="honors">
        {honors.map((item) => (
          <li>
            <time>{item.period}</time>
            <div>
              <h3>{item.title}</h3>
              <p class="honor-issuer">{item.issuer}</p>
              {item.detail && <p>{item.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="activities-heading">
      <div class="section-label">
        <h2 id="activities-heading">Selected Activities</h2>
        <span>05</span>
      </div>
      <ol class="activities">
        {featuredActivities.map((item) => (
          <li>
            <time datetime={item.date}>{item.date.slice(0, 4)}</time>
            <div>
              <p>{item.category}</p>
              <h3>{item.title}</h3>
              <span>{item.summary}</span>
            </div>
            <a href={`${base}archive/#${item.id}`} aria-label={`View ${item.title}`}>
              ↗
            </a>
          </li>
        ))}
      </ol>
    </section>

    <nav class="career-links" aria-label="Career links">
      <a href={`${base}archive/`}>Full archive <span aria-hidden="true">→</span></a>
      <a href="https://www.linkedin.com/in/donghyeok-kim-061433279/" rel="me">
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a href="https://github.com/donghyeok-k" rel="me">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </main>
</SiteLayout>

<style>
  .research-records li { scroll-margin-top: 100px; }
  .timeline li[id] { scroll-margin-top: 32px; }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 12px;
    color: var(--accent);
    font-size: var(--font-caption);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  .career {
    padding: clamp(64px, 9vw, 112px) 0 clamp(96px, 12vw, 152px);
  }

  .career-header,
  .section,
  .career-links {
    width: min(100%, var(--content-wide));
    margin-inline: auto;
  }

  .eyebrow,
  .intro,
  .section,
  .career-links {
    font-family: var(--sans);
  }

  .eyebrow {
    margin: 0 0 20px;
    color: var(--accent);
    font-size: var(--font-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
  }

  h1 {
    margin: 0;
    font-size: clamp(58px, 7vw, 88px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.06;
  }

  .intro {
    max-width: 560px;
    margin: 34px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: var(--font-copy);
    line-height: var(--leading-copy);
  }

  .section {
    margin-top: clamp(78px, 10vw, 128px);
  }

  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ink);
  }

  .section-label h2,
  .section-label span {
    margin: 0;
    color: var(--ink-faint);
    font-size: var(--font-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .timeline,
  .honors,
  .activities {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li,
  .honors li {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 34px;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }

  .timeline time,
  .honors time,
  .activities time {
    color: var(--accent);
    font-size: var(--font-caption);
    font-weight: 700;
    letter-spacing: 0.02em;
    padding-top: 5px;
  }

  .timeline h3,
  .honors h3,
  .activities h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }

  .timeline p {
    max-width: 660px;
    margin: 12px 0 0;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: var(--font-copy);
    line-height: var(--leading-copy);
    word-break: keep-all;
  }

  .timeline .organization {
    margin-top: 7px;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: var(--font-caption);
    font-weight: 700;
  }

  .honors p {
    max-width: 660px;
    margin: 8px 0 0;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: var(--font-copy);
    line-height: var(--leading-copy);
    word-break: keep-all;
  }

  .honors .honor-issuer {
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: var(--font-caption);
    font-weight: 700;
  }

  .activities li {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 44px;
    gap: 28px;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--rule);
  }

  .activities p {
    margin: 0 0 8px;
    color: var(--ink-faint);
    font-size: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .activities div > span {
    display: block;
    max-width: 680px;
    margin-top: 10px;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: var(--font-copy);
    line-height: var(--leading-copy);
    word-break: keep-all;
  }

  .activities a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-height: 44px;
    color: var(--accent);
    font-size: 16px;
    text-decoration: none;
  }

  .career-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 48px;
  }

  .career-links a {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    min-height: 44px;
    font-size: var(--font-caption);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .career-links a:hover {
    color: var(--accent);
  }

  .career-links span {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .career {
      padding: 54px 0 96px;
    }

    h1 {
      font-size: clamp(58px, 18vw, 78px);
    }

    .timeline li,
    .honors li {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .activities li {
      grid-template-columns: 52px minmax(0, 1fr) 44px;
      gap: 14px;
    }
  }

  @media (max-width: 420px) {
    .activities li {
      grid-template-columns: 1fr 44px;
    }

    .activities time {
      grid-column: 1 / -1;
    }
  }
</style>
