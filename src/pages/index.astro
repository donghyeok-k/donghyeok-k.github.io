---
import SiteLayout from "../layouts/SiteLayout.astro";

const title =
  "김동혁 (Donghyeok Kim) | Energy Systems · Carbon Markets · Computational Modeling";
const description =
  "KENTECH 학부연구생 김동혁의 에너지 시스템, 탄소시장, 계산 모델링 연구와 공개 활동 기록.";
const base = import.meta.env.BASE_URL;
const siteRoot = Astro.site ?? new URL("https://donghyeok-k.github.io");
const researchProjects = [
  "Modeling and Analysis of Cryogenic Conductor Performance",
  "Global Carbon Allowance Futures Markets: Lessons for Korea",
  "Numerical Analysis of Nanofluid Systems",
];
const additionalGraph = [
  {
    "@type": "ItemList",
    "@id": new URL("#research-in-progress", siteRoot).href,
    name: "Research in Progress",
    itemListElement: researchProjects.map((name, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "CreativeWork",
        name,
        author: { "@id": new URL("#donghyeok-kim", siteRoot).href },
      },
    })),
  },
];
---

<SiteLayout
  title={title}
  description={description}
  lang="en"
  bodyClass="home-page"
  additionalGraph={additionalGraph}
>
  <main id="content" class="home" aria-labelledby="main-title">
    <section class="cover page-shell">
      <img
        class="connection-field"
        src={`${base}images/editological-thinking.webp`}
        width="1536"
        height="1024"
        alt=""
        aria-hidden="true"
      />

      <img
        class="portrait"
        src={`${base}images/donghyeok-kim-cutout.webp`}
        width="760"
        height="785"
        alt="Donghyeok Kim portrait"
        fetchpriority="high"
      />

      <div class="statement">
        <p class="kicker">ENERGY SYSTEMS · CARBON MARKETS · COMPUTATIONAL MODELING</p>
        <h1 id="main-title">
          Models for
          <span>real-world problems.</span>
        </h1>
        <p class="dek">
          Undergraduate researcher at KENTECH working across energy systems,
          carbon markets, and computational modeling.
        </p>
        <p class="thesis">
          I use quantitative analysis to make assumptions, evidence, and
          practical implications explicit.
        </p>
      </div>

      <nav class="landing-links" aria-label="Explore">
        <a href={`${base}blog/`}>
          <span>01</span>
          <strong>READ WRITING</strong>
          <b aria-hidden="true">→</b>
        </a>
        <a href={`${base}archive/`}>
          <span>02</span>
          <strong>VIEW ARCHIVE</strong>
          <b aria-hidden="true">→</b>
        </a>
      </nav>
    </section>

    <section class="research page-shell" aria-labelledby="research-heading">
      <header class="research-header">
        <p>RESEARCH IN PROGRESS / 03</p>
        <h2 id="research-heading">Research<br />in Progress</h2>
      </header>

      <ol class="research-list" role="list">
        {
          researchProjects.map((project, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{project}</h3>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</SiteLayout>

<style>
  :global(body.home-page) {
    overflow-x: hidden;
  }

  .cover {
    position: relative;
    isolation: isolate;
    min-height: max(660px, calc(100svh - 180px));
    overflow: hidden;
  }

  .statement {
    position: relative;
    z-index: 4;
    width: min(61%, 730px);
    padding-top: clamp(54px, 8.5vh, 86px);
  }

  .kicker,
  .landing-links {
    font-family: var(--sans);
  }

  .kicker {
    margin: 0 0 clamp(16px, 2.4vh, 24px);
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  h1 {
    margin: 0;
    font-size: clamp(52px, 6.2vw, 84px);
    font-weight: 700;
    letter-spacing: -0.027em;
    line-height: 0.92;
  }

  h1 span {
    display: block;
    margin-top: 0.13em;
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: -0.018em;
  }

  .dek {
    margin: clamp(22px, 3.4vh, 34px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(19px, 1.8vw, 25px);
    line-height: 1.45;
  }

  .thesis {
    max-width: 510px;
    margin: clamp(20px, 3.2vh, 32px) 0 0;
    padding-top: clamp(16px, 2.2vh, 22px);
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.62;
  }

  .thesis::before {
    display: inline-block;
    width: 24px;
    height: 2px;
    margin: 0 10px 0.28em 0;
    background: var(--accent);
    content: "";
  }

  .connection-field {
    position: absolute;
    z-index: 1;
    right: -7%;
    bottom: -7%;
    width: min(78vw, 1020px);
    height: auto;
    opacity: 0.38;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .portrait {
    position: absolute;
    z-index: 3;
    right: clamp(0px, 2.8vw, 36px);
    bottom: -2px;
    width: clamp(270px, 28vw, 380px);
    height: auto;
    pointer-events: none;
  }

  .landing-links {
    position: absolute;
    z-index: 5;
    bottom: 24px;
    left: 0;
    display: flex;
    flex-direction: column;
  }

  .landing-links a {
    display: grid;
    grid-template-columns: 28px auto 20px;
    gap: 10px;
    align-items: center;
    min-width: 180px;
    min-height: 44px;
    padding: 8px 4px;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .landing-links a span {
    color: var(--ink-faint);
    font-weight: 600;
  }

  .landing-links a strong {
    font-size: inherit;
    font-weight: 700;
  }

  .landing-links a b {
    color: var(--accent);
    font-size: 13px;
    transition: transform 160ms ease;
  }

  .landing-links a:hover,
  .landing-links a:focus-visible {
    border-color: var(--ink);
    background: var(--paper-deep);
    box-shadow: inset 2px 0 var(--accent);
    color: var(--ink);
  }

  .landing-links a:hover b,
  .landing-links a:focus-visible b {
    transform: translateX(4px);
  }

  .research {
    display: grid;
    grid-template-columns: minmax(200px, 3fr) minmax(0, 9fr);
    gap: clamp(40px, 7vw, 96px);
    padding: clamp(80px, 10vw, 112px) 0 clamp(96px, 11vw, 120px);
    border-top: 1px solid var(--ink);
  }

  .research-header p,
  .research-list {
    font-family: var(--sans);
  }

  .research-header p {
    margin: 0 0 20px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .research-header h2 {
    margin: 0;
    font-size: clamp(42px, 4.7vw, 62px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .research-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .research-list li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    padding: clamp(24px, 3vw, 34px) 0;
    border-bottom: 1px solid var(--rule);
  }

  .research-list span {
    padding-top: 6px;
    color: var(--accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .research-list h3 {
    max-width: 720px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  @media (max-height: 760px) and (min-width: 761px) {
    .statement {
      padding-top: 38px;
    }

    h1 {
      font-size: clamp(48px, 5.7vw, 70px);
    }

    .dek {
      margin-top: 18px;
    }

    .thesis {
      margin-top: 16px;
      padding-top: 14px;
      font-size: 14px;
    }
  }

  @media (max-width: 800px) {
    .cover {
      min-height: 820px;
    }

    .statement {
      width: 100%;
      padding-top: 46px;
    }

    .kicker {
      margin-bottom: 15px;
    }

    h1 {
      max-width: 620px;
      font-size: clamp(43px, 12.8vw, 64px);
    }

    .dek {
      margin-top: 20px;
      font-size: clamp(17px, 5vw, 22px);
    }

    .thesis {
      width: min(76%, 440px);
      margin-top: 18px;
      padding-top: 14px;
      font-size: 13px;
      line-height: 1.55;
    }

    .connection-field {
      right: -40%;
      bottom: -1%;
      width: 130vw;
      opacity: 0.22;
    }

    .portrait {
      right: -5%;
      width: min(64vw, 270px);
    }

    .landing-links {
      bottom: 20px;
    }

    .research {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 80px 0 104px;
    }

    .research-header h2 br {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .cover {
      min-height: 790px;
    }

    .statement {
      padding-top: 36px;
    }

    .thesis {
      max-width: 68%;
      font-size: 12px;
    }

    .portrait {
      right: -8%;
      width: 64vw;
    }

    .landing-links a {
      min-width: 158px;
    }

    .research-list li {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 10px;
    }

    .research-list h3 {
      font-size: clamp(23px, 7.6vw, 30px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-links a,
    .landing-links a b {
      transition: none;
    }
  }
</style>
