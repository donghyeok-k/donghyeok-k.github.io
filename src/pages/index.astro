---
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "Donghyeok Kim — Energy & Applied AI";
const description =
  "Donghyeok Kim studies energy systems and applied AI, with an interest in quantitative trading.";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title={title}
  description={description}
  lang="en"
  bodyClass="home-page"
>
  <main id="content" class="cover page-shell" aria-labelledby="main-title">
    <img
      class="connection-field"
      src={`${base}images/editological-thinking.webp`}
      width="1536"
      height="1024"
      alt=""
      aria-hidden="true"
    />

    <img
      class="portrait"
      src={`${base}images/donghyeok-kim-cutout.webp`}
      width="760"
      height="785"
      alt="Donghyeok Kim portrait"
      fetchpriority="high"
    />

    <section class="statement">
      <p class="kicker">ENERGY ENGINEERING · APPLIED AI</p>
      <h1 id="main-title">
        Models for
        <span>real-world problems.</span>
      </h1>
      <p class="dek">
        I study energy systems at KENTECH and use AI models to solve practical
        problems.
      </p>
      <p class="thesis">
        Also exploring quantitative trading, with a focus on NQ futures.
      </p>
    </section>

    <nav class="landing-links" aria-label="Explore">
      <a href={`${base}blog/`}>
        <span>01</span>
        <strong>OPEN BLOG</strong>
        <b aria-hidden="true">→</b>
      </a>
      <a href={`${base}archive/`}>
        <span>02</span>
        <strong>VIEW ARCHIVE</strong>
        <b aria-hidden="true">→</b>
      </a>
    </nav>
  </main>
</SiteLayout>

<style>
  :global(body.home-page) {
    overflow-x: hidden;
  }

  .cover {
    position: relative;
    isolation: isolate;
    min-height: max(660px, calc(100svh - 180px));
    overflow: hidden;
  }

  .statement {
    position: relative;
    z-index: 4;
    width: min(61%, 730px);
    padding-top: clamp(54px, 8.5vh, 86px);
  }

  .kicker,
  .landing-links {
    font-family: var(--sans);
  }

  .kicker {
    margin: 0 0 clamp(16px, 2.4vh, 24px);
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  h1 {
    margin: 0;
    font-size: clamp(52px, 6.2vw, 84px);
    font-weight: 700;
    letter-spacing: -0.027em;
    line-height: 0.92;
  }

  h1 span {
    display: block;
    margin-top: 0.13em;
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: -0.018em;
  }

  .dek {
    margin: clamp(22px, 3.4vh, 34px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(19px, 1.8vw, 25px);
    line-height: 1.45;
  }

  .thesis {
    max-width: 510px;
    margin: clamp(20px, 3.2vh, 32px) 0 0;
    padding-top: clamp(16px, 2.2vh, 22px);
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.62;
  }

  .thesis::before {
    display: inline-block;
    width: 24px;
    height: 2px;
    margin: 0 10px 0.28em 0;
    background: var(--accent);
    content: "";
  }

  .connection-field {
    position: absolute;
    z-index: 1;
    right: -7%;
    bottom: -7%;
    width: min(78vw, 1020px);
    height: auto;
    opacity: 0.38;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .portrait {
    position: absolute;
    z-index: 3;
    right: clamp(0px, 2.8vw, 36px);
    bottom: -2px;
    width: clamp(270px, 28vw, 380px);
    height: auto;
    pointer-events: none;
  }

  .landing-links {
    position: absolute;
    z-index: 5;
    bottom: 24px;
    left: 0;
    display: flex;
    flex-direction: column;
  }

  .landing-links a {
    display: grid;
    grid-template-columns: 28px auto 20px;
    gap: 10px;
    align-items: center;
    min-width: 180px;
    min-height: 44px;
    padding: 8px 4px;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .landing-links a span {
    color: var(--ink-faint);
    font-weight: 600;
  }

  .landing-links a strong {
    font-size: inherit;
    font-weight: 700;
  }

  .landing-links a b {
    color: var(--accent);
    font-size: 13px;
    transition: transform 160ms ease;
  }

  .landing-links a:hover,
  .landing-links a:focus-visible {
    border-color: var(--ink);
    background: var(--paper-deep);
    box-shadow: inset 2px 0 var(--accent);
    color: var(--ink);
  }

  .landing-links a:hover b,
  .landing-links a:focus-visible b {
    transform: translateX(4px);
  }

  @media (max-height: 760px) and (min-width: 761px) {
    .statement {
      padding-top: 38px;
    }

    h1 {
      font-size: clamp(48px, 5.7vw, 70px);
    }

    .dek {
      margin-top: 18px;
    }

    .thesis {
      margin-top: 16px;
      padding-top: 14px;
      font-size: 14px;
    }
  }

  @media (max-width: 800px) {
    .cover {
      min-height: 820px;
    }

    .statement {
      width: 100%;
      padding-top: 46px;
    }

    .kicker {
      margin-bottom: 15px;
    }

    h1 {
      max-width: 620px;
      font-size: clamp(43px, 12.8vw, 64px);
    }

    .dek {
      margin-top: 20px;
      font-size: clamp(17px, 5vw, 22px);
    }

    .thesis {
      width: min(76%, 440px);
      margin-top: 18px;
      padding-top: 14px;
      font-size: 13px;
      line-height: 1.55;
    }

    .connection-field {
      right: -40%;
      bottom: -1%;
      width: 130vw;
      opacity: 0.22;
    }

    .portrait {
      right: -5%;
      width: min(64vw, 270px);
    }

    .landing-links {
      bottom: 20px;
    }
  }

  @media (max-width: 420px) {
    .cover {
      min-height: 790px;
    }

    .statement {
      padding-top: 36px;
    }

    .thesis {
      max-width: 68%;
      font-size: 12px;
    }

    .portrait {
      right: -8%;
      width: 64vw;
    }

    .landing-links a {
      min-width: 158px;
    }
  }
</style>
