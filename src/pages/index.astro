---
const title = "Donghyeok Kim — Editological Thinking";
const description =
  "Editological Thinking in the Era of AI — a personal monograph by Donghyeok Kim.";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,700;6..72,800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="masthead page-shell">
      <a class="wordmark" href={base} aria-label="Donghyeok Kim home">
        DONGHYEOK KIM
      </a>

      <div class="masthead-end">
        <p class="edition">A PERSONAL MONOGRAPH · 2026</p>
        <a class="blog-tab" href={`${base}blog/`}>BLOG</a>
      </div>
    </header>

    <main class="cover page-shell" aria-labelledby="main-title">
      <img
        class="connection-field"
        src={`${base}images/editological-thinking.webp`}
        width="1536"
        height="1024"
        alt=""
        aria-hidden="true"
      />

      <section class="statement">
        <p class="kicker">EDITORIAL POSITION</p>
        <h1 id="main-title">
          Editological Thinking
          <span>in the Era of AI</span>
        </h1>
        <p class="dek">Connections are remade.<br />A point of view is chosen.</p>
        <p class="thesis">
          AI can rearrange the field of information. Editing is the human act of
          deciding what belongs together—and from where to look.
        </p>
      </section>

      <footer class="colophon" aria-label="Profile">
        <p><span>NAME</span> Donghyeok Kim</p>
        <p><span>AGE</span> 24</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    --paper: #faf7f1;
    --ink: #191817;
    --ink-soft: #4c4a46;
    --ink-faint: #8a867e;
    --crimson: #a51c30;
    --rule: #dcd6ca;
    --page: 1240px;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--paper);
    color: var(--ink);
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100svh;
    overflow-x: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: "Newsreader", Georgia, serif;
    font-optical-sizing: auto;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--crimson);
    outline-offset: 5px;
  }

  .page-shell {
    width: min(calc(100% - 56px), var(--page));
    margin-inline: auto;
  }

  .masthead {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
    padding-top: 27px;
    border-bottom: 2px solid var(--ink);
    font-family: "Inter", Arial, sans-serif;
  }

  .wordmark {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-decoration: none;
  }

  .masthead-end {
    display: flex;
    gap: 28px;
    align-items: baseline;
  }

  .edition {
    margin: 0;
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .blog-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-inline: 2px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-decoration: none;
  }

  .blog-tab::after {
    position: absolute;
    right: 2px;
    bottom: 0;
    left: 2px;
    height: 2px;
    background: var(--crimson);
    content: "";
  }

  .cover {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - 68px);
    overflow: hidden;
  }

  .statement {
    position: relative;
    z-index: 4;
    width: min(61%, 730px);
    padding-top: clamp(46px, 8.5vh, 86px);
  }

  .kicker,
  .colophon {
    font-family: "Inter", Arial, sans-serif;
  }

  .kicker {
    margin: 0 0 clamp(16px, 2.4vh, 24px);
    color: var(--crimson);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  h1 {
    margin: 0;
    font-size: clamp(52px, 6.2vw, 84px);
    font-weight: 800;
    letter-spacing: -0.027em;
    line-height: 0.92;
  }

  h1 span {
    display: block;
    margin-top: 0.13em;
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: -0.018em;
  }

  .dek {
    margin: clamp(22px, 3.4vh, 34px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(19px, 1.8vw, 25px);
    line-height: 1.45;
  }

  .thesis {
    max-width: 510px;
    margin: clamp(20px, 3.2vh, 32px) 0 0;
    padding-top: clamp(16px, 2.2vh, 22px);
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.62;
  }

  .thesis::before {
    display: inline-block;
    width: 24px;
    height: 2px;
    margin: 0 10px 0.28em 0;
    background: var(--crimson);
    content: "";
  }

  .connection-field {
    position: absolute;
    z-index: 1;
    right: -8%;
    bottom: -6%;
    width: min(82vw, 1080px);
    height: auto;
    opacity: 0.5;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .colophon {
    position: absolute;
    z-index: 5;
    bottom: 24px;
    left: 0;
    display: flex;
    gap: 34px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .colophon p {
    margin: 0;
  }

  .colophon span {
    margin-right: 8px;
    color: var(--ink-faint);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  @media (max-height: 730px) and (min-width: 761px) {
    .statement {
      padding-top: 34px;
    }

    h1 {
      font-size: clamp(48px, 5.7vw, 70px);
    }

    .dek {
      margin-top: 18px;
    }

    .thesis {
      margin-top: 16px;
      padding-top: 14px;
      font-size: 14px;
    }
  }

  @media (max-width: 760px) {
    .page-shell {
      width: min(calc(100% - 36px), var(--page));
    }

    .masthead {
      height: 58px;
      padding-top: 18px;
    }

    .masthead-end {
      gap: 0;
    }

    .edition {
      display: none;
    }

    .blog-tab {
      min-height: 28px;
    }

    .cover {
      min-height: calc(100svh - 58px);
    }

    .statement {
      width: 100%;
      padding-top: clamp(34px, 6vh, 56px);
    }

    .kicker {
      margin-bottom: 15px;
    }

    h1 {
      max-width: 620px;
      font-size: clamp(43px, 12.8vw, 64px);
    }

    .dek {
      margin-top: 20px;
      font-size: clamp(17px, 5vw, 22px);
    }

    .thesis {
      width: min(78%, 440px);
      margin-top: 18px;
      padding-top: 14px;
      font-size: 13px;
      line-height: 1.55;
    }

    .connection-field {
      right: -48%;
      bottom: -2%;
      width: 145vw;
      opacity: 0.38;
    }

    .colophon {
      bottom: 18px;
      gap: 20px;
      font-size: 9px;
    }
  }

  @media (max-width: 420px), (max-height: 650px) {
    .thesis {
      max-width: 64%;
      font-size: 12px;
    }

    .colophon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      scroll-behavior: auto !important;
    }
  }

  @media print {
    :global(body) {
      background: #fff;
    }

    .cover {
      min-height: 90vh;
    }
  }
</style>
