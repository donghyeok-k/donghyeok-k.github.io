---
const title = "김동혁 — Editological Thinking";
const description = "Editological Thinking in the Era of AI — 김동혁의 개인 모노그래프.";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF7F1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,700;6..72,800&family=Noto+Serif+KR:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="masthead page-shell">
      <a class="wordmark" href="/" aria-label="김동혁 홈">KIM DONGHYEOK</a>
      <p class="edition">A PERSONAL MONOGRAPH · 2026</p>
    </header>

    <main>
      <section class="spotlight page-shell" aria-labelledby="main-title">
        <div class="spotlight-copy">
          <p class="kicker">SPOTLIGHT</p>
          <h1 id="main-title">
            Editological Thinking
            <span>in the Era of AI</span>
          </h1>
          <p class="dek">연결은 새로워지고,<br />관점은 선택된다.</p>
          <dl class="identity" aria-label="프로필">
            <div>
              <dt>NAME</dt>
              <dd>김동혁</dd>
            </div>
            <div>
              <dt>AGE</dt>
              <dd>24</dd>
            </div>
          </dl>
        </div>

        <figure class="portrait">
          <img
            src="/images/donghyeok-portrait.webp"
            width="1200"
            height="1600"
            alt="거리에서 촬영한 김동혁의 인물 사진"
          />
          <figcaption>김동혁 · 24</figcaption>
        </figure>
      </section>

      <section class="idea page-shell" aria-labelledby="idea-title">
        <header class="section-heading">
          <p class="kicker">IDEA IN BRIEF</p>
          <p class="exhibit-number">EXHIBIT 01</p>
        </header>

        <div class="idea-copy">
          <h2 id="idea-title">정보가 아니라,<br />그것을 바라보는 방식.</h2>
          <p>
            정보의 배열은 외부의 힘에 의해 계속 바뀐다. 편집은 그 변화 속에서
            무엇을 연결하고, 어떻게 바라볼지 결정하는 인간의 행위다.
          </p>
        </div>

        <figure class="exhibit">
          <img
            src="/images/editological-thinking.webp"
            width="1536"
            height="1024"
            loading="lazy"
            alt="흩어진 정보 조각, 외부에서 들어오는 선, 그리고 이를 바라보는 하나의 열린 관점을 표현한 추상 작품"
          />
          <figcaption>
            <span>EXHIBIT 01</span>
            외부의 개입으로 다시 맺어진 연결과, 그것을 바라보는 하나의 관점.
          </figcaption>
        </figure>
      </section>
    </main>

    <footer class="colophon page-shell">
      <p>COLOPHON</p>
      <p>김동혁 · 2026</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #faf7f1;
    --ink: #191817;
    --ink-soft: #4c4a46;
    --ink-faint: #8a867e;
    --crimson: #a51c30;
    --rule: #dcd6ca;
    --page: 1120px;
    --reading: 640px;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--paper);
    color: var(--ink);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: var(--paper);
    color: var(--ink);
    font-family: "Noto Serif KR", "Newsreader", Georgia, serif;
    font-size: 17px;
    line-height: 1.85;
    word-break: keep-all;
    text-rendering: optimizeLegibility;
    font-optical-sizing: auto;
  }

  :global(a) {
    color: inherit;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--crimson);
    outline-offset: 5px;
  }

  .page-shell {
    width: min(calc(100% - 48px), var(--page));
    margin-inline: auto;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-block: 34px 22px;
    border-bottom: 2px solid var(--ink);
    font-family: "Inter", Arial, sans-serif;
  }

  .wordmark {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-decoration: none;
  }

  .edition {
    margin: 0;
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.72fr);
    gap: clamp(48px, 8vw, 108px);
    align-items: end;
    padding-block: 76px;
  }

  .kicker,
  .exhibit-number,
  .identity dt,
  .colophon {
    font-family: "Inter", Arial, sans-serif;
  }

  .kicker {
    margin: 0 0 22px;
    color: var(--crimson);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(48px, 7vw, 78px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 0.98;
  }

  h1 span {
    display: block;
    margin-top: 0.14em;
    font-size: 0.78em;
    font-weight: 400;
    letter-spacing: -0.018em;
  }

  .dek {
    max-width: 540px;
    margin: 42px 0 0;
    color: var(--ink-soft);
    font-size: clamp(20px, 2.2vw, 25px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.65;
  }

  .identity {
    display: flex;
    gap: 44px;
    margin: 52px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  .identity div {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 12px;
  }

  .identity dt {
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .identity dd {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }

  .portrait {
    margin: 0;
  }

  .portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 48%;
    filter: saturate(0.82) contrast(1.03);
  }

  .portrait figcaption,
  .exhibit figcaption {
    font-family: "Inter", Arial, sans-serif;
    color: var(--ink-faint);
    font-size: 10px;
    letter-spacing: 0.08em;
    line-height: 1.5;
  }

  .portrait figcaption {
    margin-top: 10px;
  }

  .idea {
    padding-block: 76px 92px;
    border-top: 1px solid var(--ink);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 44px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }

  .section-heading .kicker,
  .exhibit-number {
    margin: 0;
  }

  .exhibit-number {
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .idea-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, var(--reading));
    gap: clamp(40px, 9vw, 120px);
    align-items: start;
    margin-bottom: 68px;
  }

  h2 {
    margin: 0;
    font-size: clamp(34px, 4.6vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .idea-copy > p {
    max-width: var(--reading);
    margin: 0;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.9;
  }

  .idea-copy > p::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 2px;
    margin: 0 12px 0.35em 0;
    background: var(--crimson);
  }

  .exhibit {
    margin: 0;
  }

  .exhibit img {
    display: block;
    width: 100%;
    height: auto;
  }

  .exhibit figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  .exhibit figcaption span {
    color: var(--ink);
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .colophon {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 24px 40px;
    border-top: 2px solid var(--ink);
    color: var(--ink-faint);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .colophon p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .page-shell {
      width: min(calc(100% - 36px), var(--page));
    }

    .masthead {
      align-items: flex-start;
      padding-block: 26px 18px;
    }

    .edition {
      max-width: 130px;
      text-align: right;
      line-height: 1.6;
    }

    .spotlight {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-block: 58px 72px;
    }

    h1 {
      font-size: clamp(43px, 13vw, 64px);
    }

    .dek {
      margin-top: 34px;
    }

    .identity {
      margin-top: 40px;
    }

    .portrait {
      width: min(78vw, 380px);
      margin-left: auto;
    }

    .idea {
      padding-block: 62px 76px;
    }

    .idea-copy {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 52px;
    }

    .exhibit {
      width: calc(100% + 36px);
      margin-left: -18px;
    }

    .exhibit figcaption {
      margin-inline: 18px;
    }
  }

  @media (max-width: 460px) {
    .identity {
      gap: 26px;
    }

    .identity div {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .exhibit figcaption {
      grid-template-columns: 1fr;
      gap: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  @media print {
    :global(body) {
      background: #fff;
    }

    .page-shell {
      width: 100%;
    }

    .spotlight,
    .idea {
      break-inside: avoid;
    }
  }
</style>
